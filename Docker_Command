-- Docker compose for mongo & mongo express 
    filename: mongo-compose.yaml
    content: [
        version: "3.8"
        services:
        mongodb:
            image: mongo
            ports:
            - 27017:27017
            environment:
            MONGO_INITDB_ROOT_USERNAME: admin
            MONGO_INITDB_ROOT_PASSWORD: admin
            networks:
            - mongo-network
        mongo-express:
            image: mongo-express
            ports: 
            - 8081:8081
            environment:
            ME_CONFIG_BASICAUTH_USERNAME: admin
            ME_CONFIG_BASICAUTH_PASSWORD: admin
            ME_CONFIG_MONGODB_ADMINUSERNAME: admin
            ME_CONFIG_MONGODB_ADMINPASSWORD: admin
            ME_CONFIG_MONGODB_PORT: 27017
            ME_CONFIG_MONGODB_SERVER: mongodb
            networks:
            - mongo-network
        networks:
        mongo-network:
            driver: bridge        
    ]
    command: 
        docker-compose -f mongo-compose.yaml up
    
-- Springboot app with oracle db on docker 
    # Create springboot app with jpa & oracle db 
    # build & generate jar file 
    # create Dockerfile 
        FROM openjdk:17
        COPY target/employee-1.jar employee.jar
        ENTRYPOINT ["java", "-jar", "employee.jar"]
    # Create docker compose file (yaml)
        services:
            app:
                build: .
                ports:
                - 8080:8080
                networks:
                - employee-network
                depends_on:
                - oracleDB
            oracleDB:
                image: gvenzl/oracle-free:latest
                ports:
                - 1521:1521
                environment:
                ORACLE_PASSWORD: admin
                APP_USER: admin
                APP_USER_PASSWORD: admin
                networks:
                - employee-network
                volumes:
                - employee-volume:/opt/oracle/oradata
            networks:
            employee-network:
                driver: bridge
            volumes:
            employee-volume:
    # adjust application.properties file based on docker compose 
        spring.application.name=employee
        spring.datasource.url=jdbc:oracle:thin:@oracleDB:1521/FREEPDB1
        spring.datasource.username=admin
        spring.datasource.password=admin
        spring.datasource.driver-class-name=oracle.jdbc.OracleDriver
        spring.jpa.database-platform=org.hibernate.dialect.OracleDialect
        spring.jpa.hibernate.ddl-auto=update
        spring.jpa.show-sql=true
        spring.jpa.properties.hibernate.format_sql=true
    # Command
        docker-compose up --build
        docker-compose down

