-- Springboot with Postgress
    -- Springboot app with rest (post & get)
        "create basic spring boot app with postgress & jpa 
    -- docker file
        file name: Dockerfile
        content: FROM openjdk:17.0.2-jdk-oraclelinux8
                 COPY target/student-1.jar student.jar
                 ENTRYPOINT ["java", "-jar", "student.jar"]
    -- docker compose 
        fileName: docker-compose.yaml
        content:
            version: "3.8"
            services:
            app:
                build: .
                ports:
                - 8080:8080
                networks:
                - student-ntw
                depends_on:
                - postgress
            postgress:
                image: postgres
                environment:
                POSTGRES_USER: admin
                POSTGRES_PASSWORD: Admin1234
                POSTGRES_DB: Student
                ports:
                - 5432:5432
                networks:
                - student-ntw
                volumes:
                - student-data:/var/lib/postgresql/data
            networks:
            student-ntw:
                driver: bridge 
            volumes:
                student-data:

    -- build 
        docker-compose up --build
    -- down 
        docker-compose down

